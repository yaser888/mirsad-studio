# ── Hermes Agent — API keys ──────────────────────────────────────────────
# Copy this file to ~/.hermes/.env (recommended) or to the project folder
# as `.env`, then fill in the key for the provider(s) you want to use.

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# ── Local Ollama (no key required) ───────────────────────────────────────
# Install from https://ollama.com then run: ollama pull qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Defaults (optional) ───────────────────────────────────────────────────
# HERMES_PROVIDER=openai
# HERMES_MODEL=gpt-4o-mini
# HERMES_TEMPERATURE=0.2
# HERMES_MAX_STEPS=12
# HERMES_MAX_HISTORY=80
# HERMES_AUTO_APPROVE=false

# ── Optional web search provider ─────────────────────────────────────────
# Without a key, web_search falls back to DuckDuckGo.
# TAVILY_API_KEY=
